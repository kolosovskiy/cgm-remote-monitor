# Сервер
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=https://crm.example.com
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
# Общий секрет для вебхуков сайта и других своих источников
WEBHOOK_SECRET=change-me
# Telegram Bot API
TELEGRAM_BOT_TOKEN=
# Binotel (webhook-ы настраиваются в кабинете Binotel, секрет сверяется в заголовке)
BINOTEL_KEY=
BINOTEL_SECRET=
# Meta (Facebook Messenger / Instagram)
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Viber Bot API
VIBER_AUTH_TOKEN=
VIBER_BOT_NAME=CRM
# Почта (IMAP для входящих, SMTP для исходящих)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_POLL_SECONDS=60
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
